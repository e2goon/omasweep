#!/usr/bin/env bash

set -uo pipefail

OMS_VERSION=0.1.0
OMS_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

source "$OMS_ROOT/lib/ui.sh"
source "$OMS_ROOT/lib/core.sh"
source "$OMS_ROOT/lib/engine.sh"
for module in system containers dev browsers apps games ai projects; do
  source "$OMS_ROOT/lib/targets/$module.sh"
done
unset module

usage() {
  cat <<EOF
${C_BOLD}omasweep${C_RESET} ${OMS_VERSION} · reclaim disk space on Omarchy

${C_BOLD}Usage${C_RESET}
  oms [clean] [options]   Scan, pick, and sweep
  oms scan [--json]       Show what can be reclaimed without touching anything
  oms whitelist           Protect paths or whole targets from sweeping
  oms log [-f]            Show the operation log
  oms link                Put oms on your PATH (~/.local/bin/oms)
  oms help | version

${C_BOLD}Clean options${C_RESET}
  -n, --dry-run           Preview the sweep, delete nothing
  -y, --yes               Sweep without asking (safe items unless --all or --only)
  -a, --all               Preselect review items too
      --only ID[,ID...]   Sweep only these targets
      --skip ID[,ID...]   Leave these targets out
      --debug             Print every command and its output
      --hold              Wait for a key before exiting (used by the bar widget)

${C_BOLD}Environment${C_RESET}
  OMS_PACMAN_KEEP=2       Package versions to keep in the pacman cache
  OMS_JOURNAL_KEEP=4weeks Journal age to keep
  OMS_STALE_DAYS=30       Days before project build output or an installer counts as stale
  OMS_PROJECT_DIRS        Colon-separated roots to search for project build output

Run ${C_BOLD}oms scan${C_RESET} to see target IDs.
EOF
}

load_gum_theme() {
  local helper
  helper=$(command -v omarchy-restart-gum 2>/dev/null) || return 0
  source "$helper"
}

on_exit() {
  spin_stop
  cursor_show
  remove_temp_files
}

on_interrupt() {
  spin_stop
  cursor_show
  printf '\n%s\n' "${C_YELLOW}${GLYPH_NOTE} Sweep cancelled. Nothing else was touched.${C_RESET}"
  exit 130
}

target_list() {
  local option=$1 value=$2 id
  [[ -n $value ]] || die "$option needs at least one target ID (see oms scan)"
  IFS=, read -r -a TARGET_LIST <<<"$value"
  for id in "${TARGET_LIST[@]}"; do
    [[ -n $id && -n ${T_LABEL[$id]:-} ]] || die "Unknown target in $option: '$id' (see oms scan)"
  done
}

in_list() {
  local item=$1 entry
  shift
  for entry in "$@"; do
    [[ $entry == "$item" ]] && return 0
  done
  return 1
}

size_label() {
  local id=$1 unknown=${2:-unknown}
  if ((${R_BYTES[$id]} < 0)); then
    printf '%s' "$unknown"
  else
    human_size "${R_BYTES[$id]}"
  fi
}

sum_bytes() {
  local id total=0
  for id in "$@"; do
    ((${R_BYTES[$id]} > 0)) && total=$((total + ${R_BYTES[$id]}))
  done
  printf '%s' "$total"
}

safe_ids() {
  local id
  for id in "${SCANNED[@]}"; do
    [[ ${R_STATUS[$id]} == ready && ${T_TIER[$id]} == safe ]] && printf '%s\n' "$id"
  done
  return 0
}

scan_all() {
  local id
  prepare_scan
  cursor_hide
  for id in "${TARGET_IDS[@]}"; do
    spin_start "Scanning ${T_LABEL[$id]}…"
    scan_target "$id"
    spin_stop
  done
  cursor_show
}

row() {
  local index=$1 id=$2 mark=$3 label size plain admin="     " detail room
  label=$(pad_right "${T_LABEL[$id]}" 26)
  size=$(color_size "${R_BYTES[$id]}")
  plain=$(size_label "$id")
  [[ ${T_SUDO[$id]} == 1 ]] && admin=" ${C_YELLOW}sudo${C_RESET}"
  detail=${R_NOTE[$id]:-${T_SECTION[$id]}}
  room=$((TERM_COLS - 51))
  if ((room < 12)); then
    detail=""
  elif ((${#detail} > room)); then
    detail="${detail:0:room-1}…"
  fi
  printf '  %s %s %s %*s%s%s  %s\n' \
    "${C_DIM}$(printf '%2s' "$index")${C_RESET}" "$mark" "$label" \
    $((9 - ${#plain})) "" "$size" "$admin" \
    "${C_DIM}${detail}${C_RESET}"
}

RANKED=()
NUMBERED=()

table_rows() {
  local title=$1 status=$2 tier=$3 mark=$4 id shown=0
  for id in "${RANKED[@]}"; do
    [[ ${R_STATUS[$id]} == "$status" ]] || continue
    [[ -z $tier || ${T_TIER[$id]} == "$tier" ]] || continue
    ((shown++)) || section "$title"
    if [[ $status == ready ]]; then
      NUMBERED+=("$id")
      row "${#NUMBERED[@]}" "$id" "$mark"
    else
      row "" "$id" "$mark"
    fi
  done
}

show_table() {
  local safe=()
  mapfile -t RANKED < <(ranked_targets)
  mapfile -t safe < <(safe_ids)
  NUMBERED=()
  table_rows "Safe to sweep · $(human_size "$(sum_bytes "${safe[@]}")")" ready safe "${C_GREEN}${GLYPH_ON}${C_RESET}"
  table_rows "Review first" ready review "${C_YELLOW}${GLYPH_OFF}${C_RESET}"
  table_rows "Skipped while in use" busy "" "${C_DIM}${GLYPH_OFF}${C_RESET}"
  if ((${#NUMBERED[@]})); then
    printf '\n  %s\n' "${C_GREEN}${GLYPH_ON}${C_RESET}${C_DIM} preselected   ${C_RESET}${C_YELLOW}${GLYPH_OFF}${C_RESET}${C_DIM} opt-in   ${C_RESET}${C_YELLOW}sudo${C_RESET}${C_DIM} asks for your password${C_RESET}"
  fi
}

nothing_to_sweep() {
  ((${#NUMBERED[@]} == 0)) || return 1
  printf '\n  %s\n' "${C_GREEN}${GLYPH_OK}${C_RESET} Nothing to sweep. Your system is already tidy."
}

SELECTED=()

default_selection() {
  local id
  SELECTED=()
  for id in "${NUMBERED[@]}"; do
    if [[ $CLEAN_ALL == 1 || ${T_TIER[$id]} == safe ]]; then
      SELECTED+=("$id")
    fi
  done
}

apply_filters() {
  local id keep=()
  if ((${#ONLY_IDS[@]})); then
    SELECTED=()
    for id in "${NUMBERED[@]}"; do
      in_list "$id" "${ONLY_IDS[@]}" && SELECTED+=("$id")
    done
  fi
  for id in "${SELECTED[@]}"; do
    in_list "$id" "${SKIP_IDS[@]}" || keep+=("$id")
  done
  SELECTED=("${keep[@]}")
}

pick_label() {
  local index=$1 id=$2
  printf '%2d  %s %9s' "$index" "$(pad_right "${T_LABEL[$id]}" 26)" "$(size_label "$id")"
  [[ ${T_SUDO[$id]} == 1 ]] && printf '  sudo'
  [[ ${T_TIER[$id]} == review ]] && printf '  review'
  return 0
}

pick_interactive() {
  local options=() preselect=() id n=0 label choice
  for id in "${NUMBERED[@]}"; do
    n=$((n + 1))
    label=$(pick_label "$n" "$id")
    options+=("$label|$id")
    in_list "$id" "${SELECTED[@]}" && preselect+=("$label")
  done

  if has_gum; then
    printf '\n'
    choice=$(gum choose --no-limit --ordered --height=$((${#options[@]} + 2)) \
      --header="Pick what to sweep" \
      --label-delimiter="|" --selected="$(join_by , "${preselect[@]}")" "${options[@]}") || return 1
    mapfile -t SELECTED <<<"$choice"
    [[ -n ${SELECTED[0]:-} ]] || SELECTED=()
    return 0
  fi

  printf '\n%s ' "Numbers to sweep (e.g. 1 2 4), Enter for preselected, a for all, q to quit:"
  read -r choice </dev/tty || return 1
  case $choice in
    "") return 0 ;;
    q | Q) return 1 ;;
    a | A)
      SELECTED=("${NUMBERED[@]}")
      return 0
      ;;
  esac
  SELECTED=()
  for n in ${choice//,/ }; do
    [[ $n =~ ^[0-9]+$ ]] || continue
    n=$((10#$n))
    ((n >= 1 && n <= ${#NUMBERED[@]})) && SELECTED+=("${NUMBERED[n - 1]}")
  done
  return 0
}

ensure_sudo() {
  local id needs=() keep=()
  for id in "${SELECTED[@]}"; do
    [[ ${T_SUDO[$id]} == 1 ]] && needs+=("${T_LABEL[$id]}")
  done
  ((${#needs[@]})) || return 0
  [[ $DRY_RUN == 1 ]] && return 0

  section "Admin access"
  printf '  %s\n' "$(join_by ", " "${needs[@]}") ${C_DIM}need${C_RESET} ${C_YELLOW}sudo${C_RESET}"
  if sudo -n true 2>/dev/null; then
    printf '  %s\n' "${C_GREEN}${GLYPH_OK}${C_RESET} Admin access already available"
    return 0
  fi
  if [[ $INTERACTIVE == 1 ]] && sudo -v; then
    printf '  %s\n' "${C_GREEN}${GLYPH_OK}${C_RESET} Admin access granted"
    return 0
  fi
  warn "No admin access. Skipping $(join_by ", " "${needs[@]}")."
  for id in "${SELECTED[@]}"; do
    [[ ${T_SUDO[$id]} == 1 ]] || keep+=("$id")
  done
  SELECTED=("${keep[@]}")
}

SWEPT_BYTES=0
SWEPT_COUNT=0
FAILED=()

report() {
  local glyph=$1 id=$2 detail=$3 suffix=${4:-}
  printf '  %s %s %s%s\n' "$glyph" "${T_LABEL[$id]}" "${C_DIM}· ${detail}${C_RESET}" "${suffix:+ $suffix}"
}

sweep() {
  local id status bytes size_text
  if [[ $DRY_RUN == 1 ]]; then
    section "Preview"
  else
    section "Sweeping"
    oplog "# ===== sweep started · $(join_by "," "${SELECTED[@]}") ====="
  fi
  cursor_hide
  for id in "${SELECTED[@]}"; do
    DRY_ACTIONS=()
    spin_start "Sweeping ${T_LABEL[$id]}…"
    clean_target "$id"
    status=$?
    spin_stop
    bytes=${R_BYTES[$id]}
    size_text=$(size_label "$id" "size unknown")
    if ((CLEAN_SKIPPED)); then
      report "${C_YELLOW}${GLYPH_OFF}${C_RESET}" "$id" "skipped, $(busy_label "${T_BUSY[$id]}") opened since the scan"
      continue
    fi
    if ((status != 0)); then
      FAILED+=("$id")
      report "${C_RED}${GLYPH_FAIL}${C_RESET}" "$id" "failed, see oms log"
      continue
    fi
    SWEPT_COUNT=$((SWEPT_COUNT + 1))
    ((bytes > 0)) && SWEPT_BYTES=$((SWEPT_BYTES + bytes))
    oplog "SWEPT $id ($size_text)"
    if [[ $DRY_RUN == 1 ]]; then
      report "${C_YELLOW}${GLYPH_DRY}${C_RESET}" "$id" "$size_text" "${C_YELLOW}dry${C_RESET}"
      dry_actions
    else
      report "${C_GREEN}${GLYPH_OK}${C_RESET}" "$id" "$size_text"
    fi
  done
  cursor_show
}

dry_actions() {
  local action shown=0
  for action in "${DRY_ACTIONS[@]}"; do
    if ((shown == 3)); then
      printf '    %s\n' "${C_DIM}${GLYPH_SUB} +$((${#DRY_ACTIONS[@]} - 3)) more${C_RESET}"
      break
    fi
    printf '    %s\n' "${C_DIM}${GLYPH_SUB} ${action}${C_RESET}"
    shown=$((shown + 1))
  done
}

summary() {
  local started=$1 free_before=$2 free_after elapsed lines=() gained
  elapsed=$((SECONDS - started))
  if [[ $DRY_RUN == 1 ]]; then
    lines+=("${C_BOLD}Preview complete${C_RESET} · nothing was deleted")
    lines+=("Could free $(human_size "$SWEPT_BYTES") from $SWEPT_COUNT items")
    lines+=("${C_DIM}Run oms to sweep for real${C_RESET}")
  else
    sync
    sleep 1
    free_after=$(free_bytes)
    gained=$((free_after - free_before))
    lines+=("${C_BOLD}Sweep complete${C_RESET} · ${elapsed}s")
    lines+=("Swept $(human_size "$SWEPT_BYTES") from $SWEPT_COUNT items")
    if ((gained >= 0)); then
      lines+=("Free space $(human_size "$free_after") ${C_GREEN}(+$(human_size "$gained"))${C_RESET}")
    else
      lines+=("Free space $(human_size "$free_after")")
    fi
    ((${#FAILED[@]})) && lines+=("${C_RED}Failed: $(join_by ", " "${FAILED[@]}")${C_RESET}")
    lines+=("${C_DIM}Log ${OMS_OPLOG/#$HOME/\~}${C_RESET}")
  fi

  printf '\n'
  if has_gum; then
    gum style --border rounded --padding "0 2" --margin "0 1" "${lines[@]}"
  else
    printf '  %s\n' "${lines[@]}"
  fi

  if [[ $DRY_RUN != 1 ]] && ((SWEPT_BYTES > 1073741824 && gained < SWEPT_BYTES / 2)) && snapper_active; then
    printf '\n'
    note "Freed less than swept. Some data may still live in Btrfs snapshots"
    note "or in hard links shared with other files. Review: sudo snapper list"
  fi
}

hold() {
  [[ $HOLD == 1 ]] || return 0
  if have omarchy-show-done; then
    omarchy-show-done
  else
    printf '\n%s' "${C_GREEN}${GLYPH_ON}${C_RESET} Done! Press any key to close..."
    read -rsn 1 </dev/tty
    printf '\n'
  fi
}

finish() {
  hold
  exit "${1:-0}"
}

CLEAN_YES=0
CLEAN_ALL=0
ONLY_IDS=()
SKIP_IDS=()

parse_clean_args() {
  HOLD=0
  while (($#)); do
    case $1 in
      -n | --dry-run) DRY_RUN=1 ;;
      -y | --yes) CLEAN_YES=1 ;;
      -a | --all) CLEAN_ALL=1 ;;
      --only | --skip)
        (($# >= 2)) || die "$1 needs at least one target ID (see oms scan)"
        set_target_list "$1" "$2"
        shift
        ;;
      --only=* | --skip=*) set_target_list "${1%%=*}" "${1#*=}" ;;
      --debug) DEBUG=1 ;;
      --hold) HOLD=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "Unknown option for oms clean: $1 (see oms help)" ;;
    esac
    shift
  done
}

set_target_list() {
  target_list "$1" "$2"
  if [[ $1 == --only ]]; then
    ONLY_IDS=("${TARGET_LIST[@]}")
  else
    SKIP_IDS=("${TARGET_LIST[@]}")
  fi
}

choose_targets() {
  default_selection
  apply_filters
  if [[ $CLEAN_YES == 0 && ${#ONLY_IDS[@]} == 0 && $INTERACTIVE == 1 ]] && ! pick_interactive; then
    printf '\n'
    note "Cancelled. Nothing was touched."
    return 1
  fi
  if ((${#SELECTED[@]} == 0)); then
    printf '\n'
    note "Nothing selected. Nothing was touched."
    return 1
  fi
  if [[ $CLEAN_YES == 1 && $CLEAN_ALL == 1 ]]; then
    local id review=()
    for id in "${SELECTED[@]}"; do
      [[ ${T_TIER[$id]} == review ]] && review+=("${T_LABEL[$id]}")
    done
    ((${#review[@]})) && warn "--all --yes includes review items: $(join_by ", " "${review[@]}")"
  fi
  if [[ $CLEAN_YES == 0 && $DRY_RUN == 0 ]]; then
    printf '\n'
    if ! confirm "Sweep ${#SELECTED[@]} items ($(human_size "$(sum_bytes "${SELECTED[@]}")"))?"; then
      note "Cancelled. Nothing was touched."
      return 1
    fi
  fi
  return 0
}

cmd_clean() {
  parse_clean_args "$@"
  INTERACTIVE=0
  [[ -t 0 && -t 1 ]] && INTERACTIVE=1
  if [[ $INTERACTIVE == 0 && $CLEAN_YES == 0 && $DRY_RUN == 0 ]]; then
    die "No terminal to confirm in. Pass --yes to sweep the safe items, or --dry-run to preview."
  fi

  local started=$SECONDS free_before
  free_before=$(free_bytes)
  banner "Sweep your Omarchy · v${OMS_VERSION}"
  if [[ $DRY_RUN == 1 ]]; then
    warn "Dry run · preview only, nothing is deleted"
  else
    note "Use --dry-run to preview · oms whitelist protects paths"
  fi

  scan_all
  show_table
  nothing_to_sweep && finish 0
  choose_targets || finish 0
  ensure_sudo
  ((${#SELECTED[@]})) || finish 0
  sweep
  summary "$started" "$free_before"
  ((${#FAILED[@]})) && finish 1
  finish 0
}

json_scan() {
  local id safe=()
  mapfile -t safe < <(safe_ids)
  ranked_targets | while IFS= read -r id; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "${T_LABEL[$id]}" "${T_SECTION[$id]}" "${T_TIER[$id]}" \
      "${T_SUDO[$id]}" "${R_BYTES[$id]}" "${R_STATUS[$id]}" "${R_NOTE[$id]}"
  done | jq -Rn --argjson safe "$(sum_bytes "${safe[@]}")" --argjson free "$(free_bytes)" --arg version "$OMS_VERSION" '
    {
      version: $version,
      freeBytes: $free,
      safeBytes: $safe,
      targets: [inputs | split("\t") | {
        id: .[0], label: .[1], section: .[2], tier: .[3], sudo: (.[4] == "1"),
        bytes: (.[5] | tonumber), status: .[6], note: .[7]
      }]
    }'
}

cmd_scan() {
  local json=0
  while (($#)); do
    case $1 in
      --json) json=1 ;;
      --debug) DEBUG=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "Unknown option for oms scan: $1" ;;
    esac
    shift
  done
  if [[ $json == 1 ]]; then
    have jq || die "oms scan --json needs jq"
    UI_TTY=0
    scan_all
    json_scan
    return
  fi
  banner "Sweep your Omarchy · v${OMS_VERSION}"
  scan_all
  show_table
  nothing_to_sweep && return
  printf '\n'
  note "IDs: $(join_by " " "${NUMBERED[@]}")"
  note "Run oms to pick and sweep, or oms clean --only ID,ID"
}

cmd_whitelist() {
  mkdir -p "$OMS_CONFIG_DIR"
  if [[ ! -f $OMS_WHITELIST ]]; then
    cat >"$OMS_WHITELIST" <<'EOF'
# omasweep whitelist
#
# One entry per line. Lines starting with # are ignored.
#
# A target ID skips that whole target:
#   docker-images
#   steam-shaders
#
# An absolute path (or ~/path) is never deleted, and neither is anything
# below it. Globs work:
#   ~/.cache/pnpm
#   ~/Work/keep-this-project/node_modules
#   ~/.cache/chromium/*/Code Cache
EOF
  fi
  if [[ ! -t 0 ]]; then
    printf '%s\n' "$OMS_WHITELIST"
    return
  fi
  local editor=()
  read -r -a editor <<<"${EDITOR:-nvim}"
  "${editor[@]}" "$OMS_WHITELIST"
}

cmd_log() {
  [[ -f $OMS_OPLOG ]] || {
    note "No sweeps logged yet."
    return
  }
  local colorize=(sed -e "s/ REMOVED / ${C_GREEN}REMOVED${C_RESET} /" -e "s/ FAILED/ ${C_RED}FAILED${C_RESET}/" -e "s/ SKIPPED / ${C_YELLOW}SKIPPED${C_RESET} /" -e "s/ RAN / ${C_BLUE}RAN${C_RESET} /")
  if [[ ${1:-} == -f ]]; then
    tail -n 40 -f "$OMS_OPLOG" | "${colorize[@]}"
  else
    tail -n 60 "$OMS_OPLOG" | "${colorize[@]}"
  fi
}

cmd_link() {
  local bin=$HOME/.local/bin
  mkdir -p "$bin"
  ln -sfn "$OMS_ROOT/bin/oms" "$bin/oms"
  printf '  %s\n' "${C_GREEN}${GLYPH_OK}${C_RESET} Linked $bin/oms → $OMS_ROOT/bin/oms"
  [[ :$PATH: == *":$bin:"* ]] || warn "$bin is not on your PATH"
}

main() {
  ui_init
  TERM_COLS=$(tput cols 2>/dev/null || printf '100')
  ((TERM_COLS > 0)) || TERM_COLS=100
  [[ $EUID == 0 ]] && die "Run omasweep as your user. It asks for sudo when a target needs it."
  trap on_exit EXIT
  trap on_interrupt INT TERM
  validate_settings
  load_gum_theme
  load_whitelist

  local command=${1:-clean}
  case $command in
    --version | -v | --help | -h) ;;
    -*) command=clean ;;
    *) (($#)) && shift ;;
  esac
  case $command in
    clean) cmd_clean "$@" ;;
    scan) cmd_scan "$@" ;;
    whitelist) cmd_whitelist ;;
    log) cmd_log "$@" ;;
    link) cmd_link ;;
    version | --version | -v) printf 'omasweep %s\n' "$OMS_VERSION" ;;
    help | --help | -h) usage ;;
    *) die "Unknown command: $command (see oms help)" ;;
  esac
}

main "$@"
